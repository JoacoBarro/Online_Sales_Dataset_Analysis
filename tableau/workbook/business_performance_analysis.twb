      <column caption='Average Discount' datatype='real' name='[Calculation_0307898000400384]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Discount])' />
      </column>
      <column caption='Return Rate' datatype='real' name='[Calculation_0307898000510977]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [ReturnStatus] = &apos;Returned&apos; THEN [InvoiceNo] END) / COUNT([InvoiceNo])' />
      </column>
      <column caption='Invoice Count' datatype='integer' name='[Calculation_0307898006790146]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([InvoiceNo])' />
      </column>
      <column caption='Shipping Cost Ratio' datatype='real' name='[Calculation_0307898007658499]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ShippingCost]) / SUM([NetRevenue])' />
      </column>
